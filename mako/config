# Global settings
font=monospace 10
width=300
height=150
margin=10,10
padding=15
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0

# Style colors (Dark Theme)
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

# Specific urgency levels
[urgency=high]
border-color=#f38ba8
default-timeout=0

[urgency=low]
border-color=#313244
